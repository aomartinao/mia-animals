{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "tests/**", "tools/**", "README.md", "firestore.rules"],
    "headers": [
      { "source": "**/*.@(html|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/moved.json", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
