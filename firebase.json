{
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*",
      ".git/**",
      "**/.git/**",
      "**/node_modules/**",
      "tests/**",
      "tools/**",
      ".github/**",
      "firebase.json",
      "README.md",
      "firestore.rules",
      "docs/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/moved.json",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
