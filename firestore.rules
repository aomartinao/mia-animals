rules_version = '2';

// Leaderboard for Poznávačka zvířat.
// Anyone can read the board; each (anonymously signed-in) player can only
// write their own entries, with sane values.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validName(d) {
      return nickOk(d.name);
    }
    // Nicknames are unique: the writer must own names/{nameKey(n)}.
    // nameKey mirrors nameKey() in index.html.
    function nameKey(n) {
      return n.lower().replace('[áàâä]', 'a').replace('č', 'c').replace('ď', 'd').replace('[éěë]', 'e').replace('[íï]', 'i').replace('ň', 'n').replace('[óöô]', 'o').replace('ř', 'r').replace('š', 's').replace('ť', 't').replace('[úůü]', 'u').replace('ý', 'y').replace('ž', 'z')
        .replace('[^a-z0-9]', '');
    }
    function ownsName(n) {
      return get(/databases/$(database)/documents/names/$(nameKey(n))).data.uid == request.auth.uid;
    }
    function nickOk(n) {
      return n is string && n.size() >= 2 && n.size() <= 16 && !isBadName(n) && ownsName(n);
    }

    // BEGIN NICKFILTER (generated by tools/nickfilter.mjs, do not edit by hand)
    function normName(n) {
      return n.lower().replace('[áàâä]', 'a').replace('č', 'c').replace('ď', 'd').replace('[éěë]', 'e').replace('[íï]', 'i').replace('ň', 'n').replace('[óöô]', 'o').replace('ř', 'r').replace('š', 's').replace('ť', 't').replace('[úůü]', 'u').replace('ý', 'y').replace('ž', 'z')
        .replace('[^a-z0-9@$!|€+]', '').replace('picasso|epic|peacock|cockatoo|cockpit|cocktail|hitchcock|hancock|scunthorpe|dickens|essex|sussex|sexta|shiitake|shitake', '');
    }
    function isBadName(n) {
      return normName(n).matches('.*(k+[uv]+r+v+|k+[o0]+k+[o0]+[t7+]+|c+[uv]+r+[a4@]+k+|p+[i1!|y]+c+([a4@]+|[o0]+|[uv]+|[e3€]+)|p+[i1!|y]+c+[uv]+[s5$]+|[z2]+m+r+d+|m+r+d+|j+[e3€]+[b8]+|p+r+d+[e3€]+[l1|]+|h+[o0]+v+n+|[s5$]+r+[a4@]+c+(k+|[a4@]+)|c+h+c+[a4@]+n+|k+[uv]+n+d+([a4@]+|[o0]+|[yi1!|]+|[i1!|y]+)|h+[a4@]+j+[z2]+[l1|]+|d+[e3€]+[b8]+[i1!|y]+[l1|]+|k+r+[e3€]+[t7+]+[e3€]+n+|d+[e3€]+m+[e3€]+n+[t7+]+|[i1!|y]+d+[i1!|y]+[o0]+[t7+]+|[s5$]+[uv]+k+[a4@]+[t7+]+|[b8]+[uv]+[z2]+n+|[b8]+[uv]+[z2]+[e3€]+r+|n+[e3€]+[g9]+r+|c+[i1!|y]+[g9]+[o0]+[s5$]+|c+[i1!|y]+k+[a4@]+n+|m+[a4@]+m+r+d+|k+[uv]+r+[e3€]+v+|f+[uv]+(c+|k+|q+)k+|p+h+[uv]+c+?k+|f+c+k+|f+c+[uv]+k+|f+[uv]+k+|[s5$]+h+[i1!|y]+[t7+]+|[b8]+[i1!|y]+[t7+]+c+h+|c+[uv]+n+[t7+]+|d+[i1!|y]+c+k+|c+[o0]+c+k+|p+[uv]+[s5$]+[s5$]+[yi1!|]+|[a4@]+[s5$]+[s5$]+h+[o0]+[l1|]+[e3€]+|[b8]+[a4@]+[s5$]+[t7+]+[a4@]+r+d+|w+h+[o0]+r+[e3€]+|[s5$]+[l1|]+[uv]+[t7+]+|f+[a4@]+[g9]+[g9]+[o0]+[t7+]+|n+[i1!|y]+[g9]+[g9]+|n+[i1!|y]+[g9]+[a4@]+|r+[e3€]+[t7+]+[a4@]+r+d+|w+[a4@]+n+k+|[t7+]+w+[a4@]+[t7+]+|[t7+]+[i1!|y]+[t7+]+[s5$]+|[b8]+[o0]+[o0]+[b8]+|p+[e3€]+n+[i1!|y]+[s5$]+|v+[a4@]+[g9]+[i1!|y]+n+|d+[i1!|y]+[l1|]+d+[o0]+|p+[o0]+r+n+|[s5$]+[e3€]+x+|p+[i1!|y]+[s5$]+[s5$]+|h+[i1!|y]+[t7+]+[l1|]+[e3€]+r+|n+[a4@]+[z2]+[i1!|y]+).*');
    }
    // END NICKFILTER

    // Nickname registry: first come, first served; only the owner can free it.
    match /names/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && key.matches('^[a-z0-9]{2,32}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Progress of a Google account, shared by all its devices.
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['prog', 'progEn', 'stats', 'name', 'updated'])
        && request.resource.data.prog is string && request.resource.data.prog.size() <= 60000
        && (!('progEn' in request.resource.data) || (request.resource.data.progEn is string && request.resource.data.progEn.size() <= 60000))
        && request.resource.data.stats is string && request.resource.data.stats.size() <= 2000
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 16))
        && request.resource.data.updated is timestamp;
    }

    // Ideas and bug reports from the app. Anyone signed in can send; nobody can change them.
    match /feedback/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['text', 'name', 'ctx', 'uid', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 1000
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 16))
        && request.resource.data.ctx is string && request.resource.data.ctx.size() <= 100
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is timestamp;
    }

    // All-time: animals known + total points
    match /players/{uid} {
      allow read: if true;
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'known', 'xp', 'updated'])
        && validName(request.resource.data)
        && request.resource.data.known is int
        && request.resource.data.known >= 0 && request.resource.data.known <= 147
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0 && request.resource.data.xp <= 1000000
        && request.resource.data.updated is timestamp;
    }

    // Weekly: points earned this ISO week (e.g. weeks/2026-W39/players/{uid})
    match /weeks/{week}/players/{uid} {
      allow read: if true;
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && week.size() <= 8
        && request.resource.data.keys().hasOnly(['name', 'xp', 'updated'])
        && validName(request.resource.data)
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0 && request.resource.data.xp <= 5000
        && request.resource.data.updated is timestamp;
    }

    // Duels: the creator stores the questions once; each player gets
    // exactly one result (create only, no updates).
    match /duels/{duel} {
      allow read: if true;
      allow create: if request.auth != null
        && duel.size() <= 24
        && request.resource.data.keys().hasOnly(['by', 'byName', 'q', 'n', 'created'])
        && request.resource.data.by == request.auth.uid
        && nickOk(request.resource.data.byName)
        && request.resource.data.q is string && request.resource.data.q.size() <= 20000
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 20
        && request.resource.data.created is timestamp;

      match /results/{uid} {
        allow read: if true;
        allow create: if isMe(uid)
          && request.resource.data.keys().hasOnly(['name', 'score', 'ms', 'at'])
          && validName(request.resource.data)
          && request.resource.data.score is int
          && request.resource.data.score >= 0 && request.resource.data.score <= 20
          && request.resource.data.ms is int
          && request.resource.data.ms >= 0 && request.resource.data.ms <= 3600000
          && request.resource.data.at is timestamp;
      }
    }
  }
}
